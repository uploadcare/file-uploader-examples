# Reference for the env variables used by this example.
# `.env` ships with working demo values — edit it (not this file) to
# swap in your own. Get a free Unsplash access key at
# https://unsplash.com/developers (use the "Access Key", not the Secret).
# The `NEXT_PUBLIC_` prefix lets Next.js inline the value in the
# client bundle.
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your-unsplash-access-key
